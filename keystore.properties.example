# Copy to keystore.properties (which is gitignored) and fill in.
#
# Keep the keystore itself OUTSIDE this repository. The gitignore patterns are a safety net for a
# mistake, not the plan: a key that never enters the working tree cannot be committed by accident.
#
# Two things worth knowing before you generate one:
#   * Lose this key and you can never update an installed build again — Android refuses an update
#     signed by a different key. The only way out is uninstall and reinstall, which wipes the app's
#     data, including the saved profiles and credentials.
#   * Leak it and anyone can sign an update that Android will happily install over yours.
# Back it up somewhere you would trust with a password manager, not in this directory.

# Absolute path. ~ is not expanded here; write it out in full.
storeFile=/home/you/keystores/l2tpvpn-release.jks

# With a PKCS12 keystore (the modern default) the key password must equal the store password.
storePassword=
keyAlias=l2tpvpn
keyPassword=
