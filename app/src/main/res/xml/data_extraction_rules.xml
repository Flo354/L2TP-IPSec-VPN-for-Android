<?xml version="1.0" encoding="utf-8"?>
<!--
    The preferences hold an IKE pre-shared key and a PPP password. Neither cloud backup nor
    device-to-device transfer may carry them off this handset, so every domain is excluded.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
